# React Client Configuration
# Copy this file to .env and fill in your values

# Allow development server to run with custom host configurations
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Port 3001 is where the local FastAPI server runs by default when proxied by Catalyst
REACT_APP_API_URL=http://localhost:3001

# Clerk Publishable Key for Authentication (Get it from https://dashboard.clerk.com)
REACT_APP_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
